{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-coding-plan-monitor",
  "version": "0.2.0",
  "identifier": "com.aicoding.plan-monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "volta run yarn dev",
    "beforeBuildCommand": "volta run yarn build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AI Coding Plan Monitor",
        "width": 380,
        "height": 880,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
